{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource with Micrometer metrics scraped from your application",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "BlinkHouse ClickHouse persistence layer — query latency, batch throughput, buffer health, and dead-letter monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Query Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(blinkhouse_query_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])) by (le, table, operation))",
          "legendFormat": "p50 {{table}}/{{operation}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(blinkhouse_query_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])) by (le, table, operation))",
          "legendFormat": "p95 {{table}}/{{operation}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(blinkhouse_query_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])) by (le, table, operation))",
          "legendFormat": "p99 {{table}}/{{operation}}",
          "refId": "C"
        }
      ],
      "title": "Query Latency Percentiles (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(blinkhouse_query_duration_seconds_count{outcome=\"success\"}[$__rate_interval])) by (table, operation)",
          "legendFormat": "{{table}}/{{operation}} success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(blinkhouse_query_duration_seconds_count{outcome=\"error\"}[$__rate_interval])) by (table, operation)",
          "legendFormat": "{{table}}/{{operation}} error",
          "refId": "B"
        }
      ],
      "title": "Query Throughput (req/s by outcome)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Batch Writer",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(blinkhouse_batch_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])) by (le, table))",
          "legendFormat": "p99 {{table}}",
          "refId": "A"
        }
      ],
      "title": "Batch Flush Latency p99 (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 12,
      "targets": [
        {
          "expr": "sum(rate(blinkhouse_batch_rows_total{outcome=\"success\"}[$__rate_interval])) by (table)",
          "legendFormat": "{{table}} rows/s",
          "refId": "A"
        }
      ],
      "title": "Batch Throughput (rows/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 13,
      "targets": [
        {
          "expr": "sum(rate(blinkhouse_batch_bytes_total{outcome=\"success\"}[$__rate_interval])) by (table)",
          "legendFormat": "{{table}} bytes/s",
          "refId": "A"
        }
      ],
      "title": "Batch Throughput (bytes/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "Buffer Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 90000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 21,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "blinkhouse_buffer_rows{table=~\"$table\"}",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "title": "Buffer Rows (current)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 22,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "blinkhouse_buffer_bytes{table=~\"$table\"}",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "title": "Buffer Bytes (current)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Error Signals",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 28 },
      "id": 31,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "sum(increase(blinkhouse_insert_dead_letter_rows_total[$__range])) by (table)",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "title": "Dead-Letter Rows (range total)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 28 },
      "id": 32,
      "options": { "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum(increase(blinkhouse_insert_singlerow_total[$__range])) by (table)",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "title": "Single-Row Inserts (anti-pattern P2)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "id": 33,
      "targets": [
        {
          "expr": "sum(rate(blinkhouse_query_duration_seconds_count{outcome=\"error\"}[$__rate_interval])) / sum(rate(blinkhouse_query_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "title": "Query Error Rate",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["blinkhouse", "clickhouse", "database"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(blinkhouse_query_duration_seconds_count, table)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "table",
        "options": [],
        "query": {
          "query": "label_values(blinkhouse_query_duration_seconds_count, table)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 0,
        "type": "query",
        "label": "Table"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "BlinkHouse — ClickHouse Persistence Layer",
  "uid": "blinkhouse-v1",
  "version": 1
}
